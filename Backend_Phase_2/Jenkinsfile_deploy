pipeline {

    agent any

    environment {

        // =====================================================
        // DOCKER
        // =====================================================

        DOCKER_IMAGE = "your-dockerhub-username/hubflow"
        IMAGE_TAG = "${BUILD_NUMBER}"

        // =====================================================
        // KUBERNETES
        // =====================================================

        KUBE_NAMESPACE = "hubflow"

        // =====================================================
        // TERRAFORM
        // =====================================================

        TF_DIR = "terraform"
    }


    stages {

        // =====================================================
        // 1. CHECKOUT
        // =====================================================

        stage('Checkout') {

            steps {

                echo "=============================================="
                echo "CHECKING OUT SOURCE CODE"
                echo "=============================================="

                checkout scm
            }
        }


        // =====================================================
        // 2. DOCKER BUILD
        // =====================================================

        stage('Build Docker Image') {

            steps {

                echo "=============================================="
                echo "BUILDING DOCKER IMAGE"
                echo "=============================================="

                sh """
                    docker build \
                    -t ${DOCKER_IMAGE}:${IMAGE_TAG} \
                    -t ${DOCKER_IMAGE}:latest \
                    .
                """
            }
        }


        // =====================================================
        // 3. DOCKER LOGIN
        // =====================================================

        stage('Docker Login') {

            steps {

                echo "=============================================="
                echo "LOGGING INTO DOCKER REGISTRY"
                echo "=============================================="

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login \
                        -u "$DOCKER_USERNAME" \
                        --password-stdin
                    '''
                }
            }
        }


        // =====================================================
        // 4. PUSH IMAGE
        // =====================================================

        stage('Push Docker Image') {

            steps {

                echo "=============================================="
                echo "PUSHING DOCKER IMAGE"
                echo "=============================================="

                sh """
                    docker push ${DOCKER_IMAGE}:${IMAGE_TAG}
                    docker push ${DOCKER_IMAGE}:latest
                """
            }
        }


        // =====================================================
        // 5. TERRAFORM INIT
        // =====================================================

        stage('Terraform Init') {

            steps {

                echo "=============================================="
                echo "TERRAFORM INIT"
                echo "=============================================="

                dir("${TF_DIR}") {

                    sh '''
                        terraform init
                    '''
                }
            }
        }


        // =====================================================
        // 6. TERRAFORM VALIDATE
        // =====================================================

        stage('Terraform Validate') {

            steps {

                echo "=============================================="
                echo "VALIDATING TERRAFORM"
                echo "=============================================="

                dir("${TF_DIR}") {

                    sh '''
                        terraform validate
                    '''
                }
            }
        }


        // =====================================================
        // 7. TERRAFORM PLAN
        // =====================================================

        stage('Terraform Plan') {

            steps {

                echo "=============================================="
                echo "CREATING TERRAFORM PLAN"
                echo "=============================================="

                dir("${TF_DIR}") {

                    sh """
                        terraform plan \
                        -var="app_image=${DOCKER_IMAGE}:${IMAGE_TAG}" \
                        -out=tfplan
                    """
                }
            }
        }


        // =====================================================
        // 8. TERRAFORM APPLY
        // =====================================================

        stage('Terraform Apply') {

            steps {

                echo "=============================================="
                echo "DEPLOYING TO KUBERNETES"
                echo "=============================================="

                dir("${TF_DIR}") {

                    sh '''
                        terraform apply -auto-approve tfplan
                    '''
                }
            }
        }


        // =====================================================
        // 9. WAIT FOR DEPLOYMENT
        // =====================================================

        stage('Wait For Deployment') {

            steps {

                echo "=============================================="
                echo "WAITING FOR KUBERNETES DEPLOYMENT"
                echo "=============================================="

                sh """
                    kubectl rollout status \
                    deployment/hubflow-app \
                    -n ${KUBE_NAMESPACE} \
                    --timeout=180s
                """
            }
        }


        // =====================================================
        // 10. VERIFY PODS
        // =====================================================

        stage('Verify Deployment') {

            steps {

                echo "=============================================="
                echo "VERIFYING KUBERNETES"
                echo "=============================================="

                sh """
                    kubectl get pods \
                    -n ${KUBE_NAMESPACE}

                    echo "----------------------------------------------"

                    kubectl get services \
                    -n ${KUBE_NAMESPACE}

                    echo "----------------------------------------------"

                    kubectl get deployment \
                    -n ${KUBE_NAMESPACE}
                """
            }
        }
    }


    // =========================================================
    // POST ACTIONS
    // =========================================================

    post {

        success {

            echo "=============================================="
            echo "DEPLOYMENT SUCCESSFUL"
            echo "=============================================="

            echo "Application Image:"
            echo "${DOCKER_IMAGE}:${IMAGE_TAG}"

            echo "Kubernetes Namespace:"
            echo "${KUBE_NAMESPACE}"
        }


        failure {

            echo "=============================================="
            echo "DEPLOYMENT FAILED"
            echo "=============================================="

            echo "Checking Kubernetes resources..."

            sh """
                kubectl get pods \
                -n ${KUBE_NAMESPACE} \
                || true

                kubectl get events \
                -n ${KUBE_NAMESPACE} \
                --sort-by=.lastTimestamp \
                | tail -30 \
                || true
            """
        }


        always {

            echo "=============================================="
            echo "CLEANING WORKSPACE"
            echo "=============================================="

            sh """
                docker logout || true
            """

            cleanWs()
        }
    }
}