# =========================================================

# HubFlow - Git Ignore

# =========================================================

# ---------------------------------------------------------

# Node.js

# ---------------------------------------------------------

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files / secrets

.env
.env.*
!.env.example

# Build / coverage

dist/
build/
coverage/
.nyc_output/

# ---------------------------------------------------------

# Terraform

# ---------------------------------------------------------

.terraform/
.terraform.lock.hcl

*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform variable files may contain passwords/secrets

terraform.tfvars
*.tfvars
*.tfvars.json

# Terraform override files

override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ---------------------------------------------------------

# Kubernetes

# ---------------------------------------------------------

# Local/generated Kubernetes configuration

kubeconfig
.kube/
*.kubeconfig

# Do not commit local secret manifests

# Uncomment if your Kubernetes secrets are stored in YAML

# k8s/secret.yaml

# ---------------------------------------------------------

# Docker

# ---------------------------------------------------------

*.tar
*.tar.gz

# Docker environment files

docker-compose.override.yml
docker-compose.override.yaml

# ---------------------------------------------------------

# Jenkins

# ---------------------------------------------------------

jenkins_home/
jenkins-data/
jenkins_home_backup/

# Jenkins local files

*.jpi
*.hpi

# ---------------------------------------------------------

# Logs

# ---------------------------------------------------------

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------------------------------------------------------

# Operating System

# ---------------------------------------------------------

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------------------------------------------------------

# IDE / Editors

# ---------------------------------------------------------

.vscode/
.idea/
*.iml

# VS Code local history

.history/

# Vim

*.swp
*.swo

# ---------------------------------------------------------

# Temporary files

# ---------------------------------------------------------

tmp/
temp/
*.tmp
*.temp

# ---------------------------------------------------------

